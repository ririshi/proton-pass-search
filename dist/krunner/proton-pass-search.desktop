[Desktop Entry]
Name=Proton Pass
Comment=Search Proton Pass logins and copy passwords
Type=Service
Icon=proton-pass
X-KDE-ServiceTypes=Plasma/Runner
X-KDE-PluginInfo-Name=proton-pass-search
X-KDE-PluginInfo-Version=0.1.0
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus2
X-Plasma-DBusRunner-Service=local.ProtonPassSearch
X-Plasma-DBusRunner-Path=/krunner
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Syntaxes=pp :q:
X-Plasma-Runner-Syntax-Descriptions=Finds Proton Pass logins matching :q:. Enter copies the password.
